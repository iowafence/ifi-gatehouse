# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# Base URL of the engine, which must run with ENGINE_DEMO_ROUTES=1 and must NOT have ENGINE_DEV_ROUTES set.
ENGINE_BASE_URL=http://127.0.0.1:8081
ENGINE_API_KEY=
# At least 32 random characters. Signs the anonymous demo cookie and derives the per-visitor owner id.
SESSION_SIGNING_SECRET=
