# Placeholder names only. Copy to .env (git-ignored) and fill in directly on the host.
# Never paste real values into chat transcripts, issues, or commits.

# Backend API (server-side only; the browser never sees this)
ENGINE_API_KEY=
# Leave empty. Setting it to 1 disables authentication and is for isolated local smoke tests only.
ENGINE_ALLOW_NOAUTH=
# Set to 1 to enable the anonymous demo routes used by the web workspace.
ENGINE_DEMO_ROUTES=
# Engine port (default 8080).
PORT=

# Evolus
# Empty = the client's built-in default.
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
# Bid Desk live guide (read by the web tier only; the engine never receives these). Unset or not 1 = off.
EVOLUS_AGENT_ID=
EVOLUS_DESK_ENABLED=
EVOLUS_DESK_TIMEOUT_MS=
EVOLUS_DESK_GLOBAL_PER_DAY=
EVOLUS_DESK_IP_PER_DAY=
EVOLUS_DESK_MAX_CHARS=

# AMD Token Factory (development path only; not the self-hosted AMD Developer Cloud deployment)
AMD_TOKEN_FACTORY_BASE_URL=
AMD_TOKEN_FACTORY_API_KEY=
AMD_TOKEN_FACTORY_MODEL=

# AMD Developer Cloud self-hosted vLLM (competition path)
AMD_VLLM_BASE_URL=
AMD_VLLM_API_KEY=
AMD_VLLM_MODEL_ID=

# Model endpoint used by tools/extract_scope.py (OpenAI-compatible; point at one of the AMD paths above)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Database (optional)
DATABASE_URL=
