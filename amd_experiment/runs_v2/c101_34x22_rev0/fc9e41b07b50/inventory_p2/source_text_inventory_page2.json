    {
      "rect_norm": [
        0.66288,
        0.1879,
        0.8318,
        0.19177
      ],
      "text": "9. LABOR COMPLIANCE: THE CONTRACTOR SHALL VERIFY WHETHER FEDERAL (DAVIS-BACON), STATE OR LOCAL PREVAILING-WAGE"
    },
    {
      "rect_norm": [
        0.66855,
        0.19428,
        0.83141,
        0.20409
