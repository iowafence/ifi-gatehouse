    {
      "rect_norm": [
        0.66289,
        0.17244,
        0.82862,
        0.17632
      ],
      "text": "8. BID ALTERNATE A-1 (THREE-COURT ENCLOSURE, VIEW 2) IS BID IN LIEU OF THE BASE BID FOUR-COURT ENCLOSURE (VIEW 1)."
    },
    {
      "rect_norm": [
        0.67179,
        0.17882,
        0.75438,
        0.1825
      ],
      "text": "EACH OPTION SHALL BE QUANTIFIED INDEPENDENTLY. SEE C102."
